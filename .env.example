# Postgres (Docker): postgresql+asyncpg://scanner:scanner@localhost:5432/liquidity_scanner
# Local dev without Docker:
DATABASE_URL=sqlite+aiosqlite:///./data/liquidity_scanner.db
JUP_API_KEY=
# Free tier: 1 request/second. Get a key at https://developers.jup.ag
JUP_RPS=1
QUOTE_SAMPLES=1
ENABLE_CLIFF_BISECTION=false
ENABLE_CREDIT_BUDGET=false
# Optional overrides:
# JUP_API_BASE=https://api.jup.ag
# JUP_QUOTE_VERSION=v1
LOG_LEVEL=INFO
ENABLE_SCHEDULER=true
# Refresh intervals — one asset probed at a time, respecting JUP_RPS
TIER_A_REFRESH_MINUTES=30
TIER_B_REFRESH_HOURS=2
TIER_C_REFRESH_HOURS=12
MAX_TIER_A_LAUNCHES=20
PROBE_POLL_SECONDS=5
MONTHLY_CREDIT_BUDGET=25000000
